@using Golestan.ViewModels
@model CreateStudentViewModel

@{
    ViewData["Title"] = "افزودن پرونده دانشجو";
}

<div class="page-header-box">
    <div class="page-header-title">
        <div class="page-header-icon">
            <i class="bi bi-mortarboard-fill"></i>
        </div>
        <div>
            <h2 class="fs-4 mb-1">افزودن پرونده دانشجو</h2>
            <div class="text-muted small fw-normal">انتساب نقش و پروفایل دانشجویی به یکی از کاربران ثبت‌شده در سیستم</div>
        </div>
    </div>
    <a asp-action="StudentTable" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-right me-1"></i>
        بازگشت به فهرست دانشجویان
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="form-card">
            <form asp-action="CreateStudent" method="post">
                <div class="form-group mb-3">
                    <label asp-for="UserId" class="form-label">
                        <i class="bi bi-person-check"></i>
                        انتخاب حساب کاربری
                    </label>
                    <select asp-for="UserId" class="form-select" asp-items="ViewBag.Users">
                        <option value="">-- لطفاً یک کاربر را انتخاب نمایید --</option>
                    </select>
                    <span asp-validation-for="UserId" class="text-danger small mt-1 d-block"></span>
                    <div class="form-text">کاربرانی که از قبل ثبت‌نام کرده‌اند در این لیست نمایش داده می‌شوند.</div>
                </div>

                <div class="form-group mb-4">
                    <label asp-for="EnrollmentDate" class="form-label">
                        <i class="bi bi-calendar3"></i>
                        تاریخ پذیرش و شروع تحصیل
                    </label>
                    <input asp-for="EnrollmentDate" class="form-control" type="date" />
                    <span asp-validation-for="EnrollmentDate" class="text-danger small mt-1 d-block"></span>
                </div>

                <div class="d-flex justify-content-between align-items-center pt-2">
                    <a asp-action="StudentTable" class="btn btn-outline-secondary">
                        انصراف و بازگشت
                    </a>
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="bi bi-check2-circle me-1"></i>
                        ثبت پرونده دانشجویی
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
