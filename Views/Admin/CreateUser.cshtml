@using Golestan.ViewModels
@model CreateUserViewModel

@{
    ViewData["Title"] = "ساخت کاربر جدید";
}

<div class="page-header-box">
    <div class="page-header-title">
        <div class="page-header-icon">
            <i class="bi bi-person-plus-fill"></i>
        </div>
        <div>
            <h2 class="fs-4 mb-1">تعریف و ساخت کاربر جدید</h2>
            <div class="text-muted small fw-normal">ثبت مشخصات هویتی و کلمه عبور کاربر جدید در پایگاه داده</div>
        </div>
    </div>
    <a asp-action="UserTable" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-right me-1"></i>
        بازگشت به فهرست کاربران
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="form-card">
            <form asp-action="CreateUser" method="post">
                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="FirstName" class="form-label">
                            <i class="bi bi-person"></i>
                            نام
                        </label>
                        <input asp-for="FirstName" class="form-control" placeholder="مثال: علی" autofocus />
                        <span asp-validation-for="FirstName" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="LastName" class="form-label">
                            <i class="bi bi-person"></i>
                            نام خانوادگی
                        </label>
                        <input asp-for="LastName" class="form-control" placeholder="مثال: محمدی" />
                        <span asp-validation-for="LastName" class="text-danger small mt-1 d-block"></span>
                    </div>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Email" class="form-label">
                        <i class="bi bi-envelope"></i>
                        پست الکترونیکی (ایمیل)
                    </label>
                    <div class="input-icon-group">
                        <input asp-for="Email" class="form-control" placeholder="example@university.ac.ir" dir="ltr" />
                        <i class="bi bi-at icon-inside"></i>
                    </div>
                    <span asp-validation-for="Email" class="text-danger small mt-1 d-block"></span>
                </div>

                <div class="form-group mb-4">
                    <label asp-for="Password" class="form-label">
                        <i class="bi bi-shield-lock"></i>
                        کلمه عبور
                    </label>
                    <div class="input-icon-group">
                        <input asp-for="Password" type="password" class="form-control" placeholder="حداقل ۶ کاراکتر" dir="ltr" />
                        <i class="bi bi-key icon-inside"></i>
                    </div>
                    <span asp-validation-for="Password" class="text-danger small mt-1 d-block"></span>
                </div>

                <div class="d-flex justify-content-between align-items-center pt-2">
                    <a asp-action="UserTable" class="btn btn-outline-secondary">
                        انصراف و بازگشت
                    </a>
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="bi bi-check2-circle me-1"></i>
                        ثبت و ذخیره کاربر
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
