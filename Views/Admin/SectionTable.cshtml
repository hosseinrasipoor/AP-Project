@model List<Golestan.ViewModels.SectionTableViewModel>

@{
    ViewData["Title"] = "فهرست گروه‌های درسی (سشن‌ها)";
}

<div class="page-header-box">
    <div class="page-header-title">
        <div class="page-header-icon">
            <i class="bi bi-collection-play-fill"></i>
        </div>
        <div>
            <h2 class="fs-4 mb-1">فهرست گروه‌های درسی ارائه‌شده (سشن‌ها)</h2>
            <div class="text-muted small fw-normal">برنامه‌ریزی ترمی، اساتید، کلاس‌ها، زمان‌بندی و تاریخ امتحانات نهایی</div>
        </div>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-primary" asp-action="CreateSection">
            <i class="bi bi-plus-circle-fill me-1"></i>
            ایجاد گروه درسی جدید
        </a>
        <a class="btn btn-outline-secondary" asp-action="Index">
            <i class="bi bi-arrow-right me-1"></i>
            داشبورد
        </a>
    </div>
</div>

@if (Model == null || !Model.Any())
{
    <div class="empty-state-box">
        <div class="empty-state-icon">
            <i class="bi bi-collection"></i>
        </div>
        <div class="empty-state-text">هیچ سشن یا گروه درسی ثبت نشده است.</div>
        <a class="btn btn-primary" asp-action="CreateSection">
            <i class="bi bi-plus-circle-fill me-1"></i>
            ایجاد اولین سشن
        </a>
    </div>
}
else
{
    <div class="table-container-card">
        <div class="table-responsive">
            <table class="table table-striped align-middle mb-0">
                <thead>
                    <tr>
                        <th>عنوان درس</th>
                        <th>استاد مدرس</th>
                        <th>ترم و سال</th>
                        <th>مکان کلاس</th>
                        <th>زمان برگزاری</th>
                        <th>تاریخ امتحان نهایی</th>
                        <th style="width: 170px;" class="text-center">عملیات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in Model)
                    {
                        <tr>
                            <td>
                                <div class="fw-bold fs-6 text-primary">@s.CourseTitle</div>
                            </td>
                            <td>
                                @if (string.IsNullOrWhiteSpace(s.InstructorName) || s.InstructorName == "استاد ندارد")
                                {
                                    <span class="badge badge-warning">بدون استاد</span>
                                }
                                else
                                {
                                    <span class="d-flex align-items-center gap-1">
                                        <i class="bi bi-person-check text-success"></i>
                                        @s.InstructorName
                                    </span>
                                }
                            </td>
                            <td>
                                <span class="badge badge-sky">
                                    سال @s.Year - ترم @s.Semester
                                </span>
                            </td>
                            <td>
                                <span class="badge badge-ice">
                                    <i class="bi bi-building me-1"></i>
                                    @s.ClassroomName
                                </span>
                            </td>
                            <td class="small">
                                <i class="bi bi-clock me-1 text-muted"></i>
                                @s.TimeSlotInfo
                            </td>
                            <td>
                                <span class="badge badge-danger">
                                    <i class="bi bi-calendar-event me-1"></i>
                                    @s.FinalExamDate.ToString("yyyy/MM/dd")
                                </span>
                            </td>
                            <td class="text-center">
                                <div class="d-inline-flex gap-1">
                                    <a asp-action="SectionDetails" asp-route-id="@s.Id" class="btn btn-ice btn-sm" title="مشاهده جزئیات و دانشجویان">
                                        <i class="bi bi-eye-fill me-1"></i>
                                        جزئیات
                                    </a>

                                    <form asp-action="SectionDelete" asp-route-id="@s.Id" method="post" class="d-inline" 
                                          onsubmit="return confirm('آیا از حذف این سشن درسی اطمینان دارید؟ تمامی ثبت‌نام‌های دانشجویان در این سشن حذف خواهد شد.');">
                                        <button type="submit" class="btn btn-danger btn-sm" title="حذف سشن">
                                            <i class="bi bi-trash3-fill"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
