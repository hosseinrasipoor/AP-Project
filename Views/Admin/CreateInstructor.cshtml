@using Golestan.ViewModels
@model CreateInstructorViewModel

@{
    ViewData["Title"] = "افزودن پرونده استاد جدید";
}

<div class="page-header-box">
    <div class="page-header-title">
        <div class="page-header-icon">
            <i class="bi bi-person-video3"></i>
        </div>
        <div>
            <h2 class="fs-4 mb-1">افزودن پرونده استاد جدید</h2>
            <div class="text-muted small fw-normal">انتساب نقش عضو هیئت علمی/مدرس به کاربر سیستم و تعیین حقوق و تاریخ استخدام</div>
        </div>
    </div>
    <a asp-action="InstructorTable" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-right me-1"></i>
        بازگشت به فهرست اساتید
    </a>
</div>

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="form-card">
            <form asp-action="CreateInstructor" method="post">
                <div class="form-group mb-3">
                    <label asp-for="UserId" class="form-label">
                        <i class="bi bi-person-check"></i>
                        انتخاب حساب کاربری
                    </label>
                    <select asp-for="UserId" asp-items="ViewBag.Users" class="form-select">
                        <option value="">-- لطفاً یک کاربر را انتخاب نمایید --</option>
                    </select>
                    <span asp-validation-for="UserId" class="text-danger small mt-1 d-block"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Salary" class="form-label">
                        <i class="bi bi-cash-stack"></i>
                        میزان حقوق (ریال)
                    </label>
                    <input asp-for="Salary" class="form-control" type="number" step="1000" placeholder="مثال: ۵۰۰۰۰۰۰۰" dir="ltr" />
                    <span asp-validation-for="Salary" class="text-danger small mt-1 d-block"></span>
                </div>

                <div class="form-group mb-4">
                    <label asp-for="HireDate" class="form-label">
                        <i class="bi bi-calendar-check"></i>
                        تاریخ استخدام / شروع همکاری
                    </label>
                    <input asp-for="HireDate" type="date" class="form-control" />
                    <span asp-validation-for="HireDate" class="text-danger small mt-1 d-block"></span>
                </div>

                <div class="d-flex justify-content-between align-items-center pt-2">
                    <a asp-action="InstructorTable" class="btn btn-outline-secondary">
                        انصراف و بازگشت
                    </a>
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="bi bi-check2-circle me-1"></i>
                        ثبت پرونده استاد
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
