@using Golestan.Models
@model List<Course>

@{
    ViewData["Title"] = "فهرست دروس دانشگاهی";
}

<div class="page-header-box">
    <div class="page-header-title">
        <div class="page-header-icon">
            <i class="bi bi-book-half"></i>
        </div>
        <div>
            <h2 class="fs-4 mb-1">فهرست دروس مصوب دانشگاه</h2>
            <div class="text-muted small fw-normal">مدیریت عناوین آموزشی، کد دروس و تعداد واحدهای تخصیص‌یافته</div>
        </div>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-primary" asp-action="CreateCourse">
            <i class="bi bi-plus-circle-fill me-1"></i>
            تعریف درس جدید
        </a>
        <a class="btn btn-outline-secondary" asp-action="Index">
            <i class="bi bi-arrow-right me-1"></i>
            داشبورد
        </a>
    </div>
</div>

@if (Model == null || !Model.Any())
{
    <div class="empty-state-box">
        <div class="empty-state-icon">
            <i class="bi bi-journal-x"></i>
        </div>
        <div class="empty-state-text">هیچ درسی در سامانه ثبت نشده است.</div>
        <a class="btn btn-primary" asp-action="CreateCourse">
            <i class="bi bi-plus-circle-fill me-1"></i>
            تعریف اولین درس
        </a>
    </div>
}
else
{
    <div class="table-container-card">
        <div class="table-responsive">
            <table class="table table-striped align-middle mb-0">
                <thead>
                    <tr>
                        <th style="width: 80px;">شناسه</th>
                        <th>عنوان درس</th>
                        <th>کد درس</th>
                        <th>تعداد واحد</th>
                        <th>توضیحات و سرفصل</th>
                        <th style="width: 110px;" class="text-center">عملیات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var course in Model)
                    {
                        <tr>
                            <td class="fw-bold text-muted">@course.Id</td>
                            <td>
                                <div class="fw-bold fs-6">@course.Title</div>
                            </td>
                            <td>
                                <span class="badge badge-sky font-monospace fs-6">
                                    <i class="bi bi-upc me-1"></i>
                                    @course.Code
                                </span>
                            </td>
                            <td>
                                <span class="badge badge-ice fs-6">
                                    @course.Unit واحد
                                </span>
                            </td>
                            <td class="text-muted small">
                                @(string.IsNullOrWhiteSpace(course.Description) ? "بدون توضیحات" : course.Description)
                            </td>
                            <td class="text-center">
                                <form asp-action="DeleteCourse" method="post" asp-route-id="@course.Id" class="d-inline" onsubmit="return confirm('آیا از حذف این درس اطمینان دارید؟ تمامی سشن‌های وابسته به این درس نیز حذف خواهند شد.');">
                                    <button type="submit" class="btn btn-danger btn-sm" title="حذف درس">
                                        <i class="bi bi-trash3-fill me-1"></i>
                                        حذف
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
