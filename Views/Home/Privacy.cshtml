@{
    ViewData["Title"] = "حریم خصوصی و قوانین";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="custom-card p-4 p-md-5">
            <div class="d-flex align-items-center gap-3 mb-4 pb-3 border-bottom">
                <div class="page-header-icon">
                    <i class="bi bi-shield-lock"></i>
                </div>
                <div>
                    <h2 class="fs-4 fw-bold mb-1" style="color: var(--primary-navy);">سیاست حفظ حریم خصوصی کاربران</h2>
                    <div class="text-muted small">قوانین و ضوابط امنیتی سامانه دانشگاهی گلستان</div>
                </div>
            </div>

            <p class="text-muted leading-relaxed">
                سامانه دانشگاهی گلستان خود را متعهد به حفظ محرمانگی و امنیت کامل اطلاعات فردی، سوابق تحصیلی و داده‌های آموزشی دانشجویان، اساتید و کارکنان محترم دانشگاه می‌داند.
            </p>

            <h5 class="fw-bold mt-4 mb-2" style="color: var(--primary-navy);">امنیت حساب کاربری</h5>
            <p class="text-muted">
                اطلاعات عبور شما به‌صورت رمزنگاری‌شده در پایگاه داده نگهداری شده و هرگونه ورود به سامانه در راستای حفظ امنیت کاربران ثبت و پایش می‌گردد. خواهشمند است از در اختیار گذاشتن رمز عبور خود به دیگران خودداری فرمایید.
            </p>

            <div class="mt-4 pt-3 text-start">
                <a href="/" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-right me-1"></i>
                    بازگشت به صفحه اصلی
                </a>
            </div>
        </div>
    </div>
</div>
