@model Golestan.ViewModels.Account.LoginViewModel

@{
    ViewData["Title"] = "ورود به سامانه";
    ViewData["HideNavbar"] = true;
}

<div class="login-page-body">
    <div class="login-glass-card">
        <div class="login-brand-header">
            <div class="login-emblem">
                <i class="bi bi-mortarboard-fill"></i>
            </div>
            <h1 class="login-title">سامانه جامع گلستان</h1>
            <p class="login-subtitle">پورتال خدمات الکترونیکی دانشجویان، اساتید و مدیران</p>
        </div>

        <form asp-action="Login" method="post" novalidate>
            @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors?.Count > 0)
            {
                <div class="custom-alert badge-danger mb-3 p-3 rounded-3 d-flex align-items-center gap-2">
                    <i class="bi bi-exclamation-triangle-fill fs-5"></i>
                    <div>
                        @foreach (var error in ViewData.ModelState[string.Empty].Errors)
                        {
                            <div>@error.ErrorMessage</div>
                        }
                    </div>
                </div>
            }

            <div class="form-field-group mb-3">
                <label asp-for="Email" class="form-label">
                    <i class="bi bi-envelope"></i>
                    پست الکترونیکی (ایمیل)
                </label>
                <div class="input-icon-group">
                    <input asp-for="Email" class="form-control" placeholder="example@university.ac.ir" dir="ltr" autofocus />
                    <i class="bi bi-person icon-inside"></i>
                </div>
                <span asp-validation-for="Email" class="text-danger small mt-1 d-block"></span>
            </div>

            <div class="form-field-group mb-4">
                <label asp-for="Password" class="form-label">
                    <i class="bi bi-shield-lock"></i>
                    رمز عبور
                </label>
                <div class="input-icon-group">
                    <input asp-for="Password" class="form-control" type="password" placeholder="••••••••" dir="ltr" />
                    <i class="bi bi-key icon-inside"></i>
                </div>
                <span asp-validation-for="Password" class="text-danger small mt-1 d-block"></span>
            </div>

            <button type="submit" class="btn btn-primary w-100 py-2 fs-6">
                <i class="bi bi-box-arrow-in-right ms-1"></i>
                ورود به سامانه
            </button>

            <div class="mt-4 pt-3 text-center border-top">
                <div class="text-muted small">
                    <i class="bi bi-info-circle me-1"></i>
                    در صورت فراموشی رمز عبور، با مدیریت آموزش تماس حاصل فرمایید.
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
