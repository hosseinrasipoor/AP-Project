@using System.Security.Claims
@{
    var isAuthenticated = User.Identity?.IsAuthenticated ?? false;
    var fullName = User.FindFirst(ClaimTypes.Name)?.Value;
    var hideNavbar = (bool?)ViewData["HideNavbar"] ?? false;

    string dashboardController = "";
    string roleName = "";
    if (isAuthenticated)
    {
        if (User.IsInRole("Student"))
        {
            dashboardController = "Student";
            roleName = "دانشجو";
        }
        else if (User.IsInRole("Instructor"))
        {
            dashboardController = "Instructor";
            roleName = "استاد";
        }
        else if (User.IsInRole("Admin"))
        {
            dashboardController = "Admin";
            roleName = "مدیر سیستم";
        }
    }
}

<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - سامانه دانشگاهی گلستان</title>

    <!-- فونت فارسی وزیرمتن (Vazirmatn) با پشتیبانی محلی و CDN -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/rastikerdar/vazirmatn@v33.003/Vazirmatn-font-face.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Vazirmatn:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Bootstrap 5 RTL -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <!-- استایل‌های اختصاصی -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Golestan.styles.css" asp-append-version="true" />
</head>
<body>
    <div class="site-wrapper">
        @if (!hideNavbar)
        {
            <header>
                <nav class="navbar navbar-expand-lg main-navbar">
                    <div class="container">
                        <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                            <div class="brand-icon-box">
                                <i class="bi bi-mortarboard-fill"></i>
                            </div>
                            <span>سامانه دانشگاهی گلستان</span>
                        </a>

                        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar"
                                aria-controls="mainNavbar" aria-expanded="false" aria-label="تغییر وضعیت منو">
                            <span class="navbar-toggler-icon"></span>
                        </button>

                        <div class="collapse navbar-collapse justify-content-between" id="mainNavbar">
                            <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                                @if (isAuthenticated && !string.IsNullOrEmpty(dashboardController))
                                {
                                    <li class="nav-item">
                                        <a class="nav-link" asp-controller="@dashboardController" asp-action="Index">
                                            <i class="bi bi-speedometer2"></i>
                                            داشبورد @roleName
                                        </a>
                                    </li>
                                }
                            </ul>

                            <div class="d-flex align-items-center gap-3 flex-wrap">
                                @if (isAuthenticated)
                                {
                                    <div class="user-badge-nav">
                                        <i class="bi bi-person-circle"></i>
                                        <span>@fullName</span>
                                        <span class="badge badge-ice ms-1">@roleName</span>
                                    </div>
                                    <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline m-0">
                                        <button type="submit" class="btn btn-nav-logout">
                                            <i class="bi bi-box-arrow-left"></i>
                                            خروج
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <a class="btn btn-outline-light d-flex align-items-center gap-2" asp-controller="Account" asp-action="Login">
                                        <i class="bi bi-box-arrow-in-right"></i>
                                        ورود به سامانه
                                    </a>
                                }
                            </div>
                        </div>
                    </div>
                </nav>
            </header>
        }

        <main role="main" class="container my-4">
            @RenderBody()
        </main>

        @if (!hideNavbar)
        {
            <footer class="site-footer">
                <div class="container text-center">
                    <div class="d-flex flex-column flex-md-row justify-content-between align-items-center gap-2">
                        <div>
                            <strong>سامانه جامع دانشگاهی گلستان</strong> &copy; ۱۴۰۴ - تمامی حقوق محفوظ است.
                        </div>
                        <div class="text-muted small">
                            پایگاه خدمات آموزشی و دانشجویی
                        </div>
                    </div>
                </div>
            </footer>
        }
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
