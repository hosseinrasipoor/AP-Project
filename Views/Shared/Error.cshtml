@model ErrorViewModel
@{
    ViewData["Title"] = "خطا در سامانه";
}

<div class="row justify-content-center my-4">
    <div class="col-md-7 col-lg-6">
        <div class="custom-card p-4 p-md-5 text-center">
            <div class="empty-state-icon text-danger mb-3">
                <i class="bi bi-exclamation-octagon"></i>
            </div>
            <h2 class="text-danger fw-bold fs-4 mb-2">خطایی در پردازش درخواست شما رخ داد</h2>
            <p class="text-muted mb-4">
                سامانه در هنگام پردازش این عملیات با یک خطای غیرمنتظره مواجه شد. لطفاً مجدداً تلاش کنید یا با پشتیبانی سامانه تماس بگیرید.
            </p>

            @if (Model?.ShowRequestId ?? false)
            {
                <div class="p-3 bg-light rounded-3 mb-4 text-start font-monospace small" dir="ltr">
                    <span class="text-muted">کد پیگیری خطا (Request ID):</span>
                    <strong>@Model.RequestId</strong>
                </div>
            }

            <div class="d-flex justify-content-center gap-2">
                <a href="/" class="btn btn-primary">
                    <i class="bi bi-house-door me-1"></i>
                    بازگشت به صفحه اصلی
                </a>
            </div>
        </div>
    </div>
</div>
